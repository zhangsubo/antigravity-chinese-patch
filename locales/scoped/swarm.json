  "patterns": [
    {
      "id": "swarm-needs-you",
      "parentSelector": ".o2-pchip",
      "regex": "^(\\d+) needs? you$",
      "flags": "",
      "replacement": "$1 项需要你参与"
    },
    {
      "id": "swarm-blocked",
      "parentSelector": ".o2-pchip",
      "regex": "^(\\d+) blocked$",
      "flags": "",
      "replacement": "$1 项受阻"
    },
    {
      "id": "swarm-threads-open",
      "parentSelector": ".o2-pchip",
      "regex": "^(\\d+) threads? open$",
      "flags": "",
      "replacement": "$1 条任务线未结束"
    },
    {
      "id": "swarm-active",
      "parentSelector": ".o2-pchip",
      "regex": "^(\\d+) active$",
      "flags": "",
      "replacement": "$1 项进行中"
    },
    {
      "id": "swarm-tasks-progress",
      "parentSelector": ".o2-progt > b",
      "regex": "^(\\d+) of (\\d+)$",
      "flags": "",
      "replacement": "$1 / $2"
    },
    {
      "id": "swarm-up-next",
      "parentSelector": ".o2-qhdr",
      "regex": "^Up next · (\\d+)$",
      "flags": "",
      "replacement": "接下来 · $1"
    },
    {
      "id": "swarm-plus-more",
      "parentSelector": "",
      "regex": "^\\+(\\d+) more$",
      "flags": "",
      "replacement": "还有 $1 项"
    }
  ]
}
